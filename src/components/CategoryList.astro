---
import { defaultLang, type LanguageKey } from "@/i18n/ui";
import { useTranslatedPath } from "@/i18n/utils";
import { slugify } from "@/utils/slug";

interface Props {
  /** Categories to render, in display order. */
  categories: string[];
  /** Language prefix for the generated links. */
  lang?: LanguageKey;
  /** The category of the page being viewed; marked as the current one. */
  active?: string;
  /** Base path for category links. Defaults to `/posts/categories`. */
  basePath?: string;
}

const { categories, lang = defaultLang, active, basePath = "/posts/categories" } = Astro.props;

const translatePath = useTranslatedPath(lang);
---

<ul class="list-none space-y-1" role="list">
  {categories.map((name) => (
    <li>
      <a
        href={`${translatePath(`${basePath}/${slugify(name)}`)}/`}
        aria-current={name === active ? "page" : undefined}
        aria-label={name === active ? name : undefined}
        class={name === active ? "tui-active text-accent" : undefined}
      >
        {name}
      </a>
    </li>
  ))}
</ul>
