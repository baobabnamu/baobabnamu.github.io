---
import type { CollectionEntry } from 'astro:content';
import { getSlugFromId } from '@/i18n/utils';
import { formatDate } from '@/utils/date';
import { withBase } from '@/utils/base';

interface Props {
	notes: CollectionEntry<'note'>[];
	currentSlug: string;
}

const { notes, currentSlug } = Astro.props;
---

<ul class="list-none space-y-2" role="list">
	{
		notes.map((note) => {
			const isActive = note.id === currentSlug;
			const slug = getSlugFromId(note.id);

			return (
				<li id={`note-${slug}`}>
					<div class="flex items-baseline gap-3">
						<a class={`min-w-0 transition-opacity ${isActive ? 'tui-active text-accent font-bold opacity-100' : 'truncate opacity-40 hover:opacity-100'}`} aria-label={isActive ? note.data.headline : undefined} href={withBase(`/notes/${slug}/#note-${slug}`)}>
							{note.data.headline}
						</a>
						<span class="flex-1 border-b border-dotted border-ink/25" aria-hidden="true" />
						<span class="hidden sm:inline shrink-0 font-mono text-xs text-muted">{formatDate(note.data.publishDate)}</span>
					</div>
					{isActive && (
						<div class="mt-2 prose">
							<slot />
						</div>
					)}
				</li>
			);
		})
	}
</ul>
