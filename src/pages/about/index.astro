---
import AboutNav from '@/components/AboutNav.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { aboutSections } from '@/utils/aboutSections';
import { getEntry } from 'astro:content';

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const { brand } = config.data;

const content = {
	kicker: 'INTRODUCE',
	description: `${brand.name} 소개 — 서버/인프라 관점에서 쓰는 실무 기록.`,
	title: '목적에 맞는 기술을 선택할 수 있는 엔지니어의 기록.',
	lines: [
		'안녕하세요, Bao입니다 :)',
		'겉으로 그럴싸해 보이는 해결책보다, 실제로 측정하고 검증한 결과를 남기는 걸 우선합니다.',
		'인프라뿐만 아니라 개발, AI, 보안 등 다양한 분야에 대해 거리낌 없이 빠르게 학습합니다.',
		'지금은 조금 더디더라도, 꾸준한 개선이 길게 보면 팀 전체의 시간을 아껴준다고 생각합니다.',
	],
};
---

<BaseLayout title={`${brand.name} — ${content.kicker}`} description={content.description}>
	<main class="px-4 pb-12 pt-6">
		<div class="md:flex md:gap-8">
			<AboutNav sections={aboutSections} active="introduce" />
			<div class="md:min-w-0 md:flex-1">
				<p class="label">{content.kicker}</p>
				<h1 class="mt-4 max-w-3xl text-4xl leading-[0.98] tracking-[-0.045em] sm:text-5xl md:text-6xl">{content.title}</h1>
				<div class="mt-8 max-w-4xl space-y-3 text-lg leading-relaxed text-muted md:text-xl">
					{content.lines.map((line) => <p>{line}</p>)}
				</div>
			</div>
		</div>
	</main>
</BaseLayout>
