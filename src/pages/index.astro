---
import { getEntry } from 'astro:content';
import AutoGrid from '@/components/AutoGrid.astro';
import PostItem from '@/components/PostItem.astro';
import { defaultLang } from '@/i18n/ui';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hiddenPostCount, previewPosts } from '@/utils/postPreview';
import { postsByCategoryForLang } from '@/utils/posts.ts';
import { slugify } from '@/utils/slug';

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const { brand } = config.data;

const lang = defaultLang;
const postsByCategory = postsByCategoryForLang(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={brand.name} description={brand.description}>
	<main class="px-4 pt-6 pb-12">
		<h1 class="sr-only">{brand.name}</h1>
		<section>
			<h2 class="sr-only">{t('home.postsByCategory')}</h2>
			<AutoGrid minCardWidth={600}>
				{
					postsByCategory.map(({ category, posts }) => {
						const hidden = hiddenPostCount(posts.length);
						return (
							<section>
								<h3 class="flex items-baseline justify-between gap-3 border-b border-line pb-2 text-lg">
									<a
										class="uppercase tracking-wide"
										href={`${translatePath(`/posts/categories/${slugify(category)}`)}/`}
									>
										{category}
									</a>
									<span class="font-mono text-xs font-normal tracking-widest text-muted">{posts.length}</span>
								</h3>
								<ul class="mt-3 list-none space-y-2" role="list">
									{previewPosts(posts).map((post) => <PostItem post={post} />)}
									{hidden > 0 && (
										<li>
											<a class="label" href={`${translatePath('/posts')}/`}>
												{t('home.more', { count: hidden })}
											</a>
										</li>
									)}
								</ul>
							</section>
						);
					})
				}
			</AutoGrid>
		</section>
	</main>
</BaseLayout>
