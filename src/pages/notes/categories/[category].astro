---
import CategoryNav from '@/components/CategoryNav.astro';
import NoteItem from '@/components/NoteItem.astro';
import { defaultLang } from '@/i18n/ui';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { noteCategoriesByLang, notesByLang } from '@/utils/notes';
import { slugify } from '@/utils/slug';

export function getStaticPaths() {
	return noteCategoriesByLang(defaultLang).map((category) => ({
		params: { category: slugify(category) },
		props: { category },
	}));
}

const lang = defaultLang;
const { category } = Astro.props;
const categories = noteCategoriesByLang(lang);
const notes = notesByLang(lang).filter(
	(note) => note.data.category === category,
);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={`${category} · ${t('notes.title')}`} description={t('notes.description')}>
	<main class="px-4 pt-6 pb-12">
		<div class="md:flex md:gap-8">
			<CategoryNav categories={categories} lang={lang} active={category} basePath="/notes/categories" />
			<div class="md:min-w-0 md:flex-1">
				<h1 class="text-3xl tracking-tight uppercase">{category}</h1>
				<p class="label mt-2">
					{t('notes.count', { count: notes.length })}
				</p>
				<hr class="mt-4" />
				<ul class="mt-6 list-none space-y-2" role="list">
					{notes.map((note) => <NoteItem note={note} lang={lang} />)}
				</ul>
				<hr class="mt-10" />
				<p class="mt-3 font-mono text-xs"><a href={translatePath('/notes')}>{t('common.back')}</a></p>
			</div>
		</div>
	</main>
</BaseLayout>
