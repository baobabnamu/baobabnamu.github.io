---
import CategoryNav from '@/components/CategoryNav.astro';
import NoteItem from '@/components/NoteItem.astro';
import { defaultLang } from '@/i18n/ui';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { noteCategoriesByLang, notesByLang } from '@/utils/notes';

const lang = defaultLang;
const notes = notesByLang(lang);
const categories = noteCategoriesByLang(lang);

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={t('notes.title')} description={t('notes.description')}>
	<main class="px-4 pt-6 pb-12">
		<div class="md:flex md:gap-8">
			<CategoryNav categories={categories} lang={lang} basePath="/notes/categories" />
			<div class="md:min-w-0 md:flex-1">
				<h1 class="text-3xl tracking-tight uppercase">{t('notes.title')}</h1>
				<p class="label mt-2">
					{t('notes.count', { count: notes.length })}
				</p>
				<hr class="mt-4" />
				<ul class="mt-6 list-none space-y-2" role="list">
					{notes.map((note) => <NoteItem note={note} lang={lang} />)}
				</ul>
				<hr class="mt-10" />
				<p class="mt-3 font-mono text-xs"><a href={translatePath('/')}>{t('common.back')}</a></p>
			</div>
		</div>
	</main>
</BaseLayout>
